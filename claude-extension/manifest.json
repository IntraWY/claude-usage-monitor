{
  "manifest_version": 3,
  "name": "Claude Session Optimizer",
  "short_name": "Claude Opt",
  "version": "1.0.0",
  "description": "วางแผน Ping Claude Haiku เพื่อรักษา Session ให้ต่อเนื่อง (Claude Max Plan)",
  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Session Optimizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
