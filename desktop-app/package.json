{
  "name": "ai-usage-monitor-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "package:win": "electron-builder --win zip --x64",
    "installer:win": "electron-builder --win nsis --x64",
    "portable:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "playwright": "1.59.1"
  },
  "build": {
    "appId": "com.intrawy.aiusagemonitor",
    "productName": "AI Usage Monitor",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "icon": "src/assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "normal"
  },
  "description": "Minimal multi-account Codex and Claude usage monitor for Windows",
  "repository": {
    "type": "git",
    "url": "https://github.com/IntraWY/claude-usage-monitor.git"
  }
}
